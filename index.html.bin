// ==========================================
// 1. БИБЛИОТЕКАЛАР ЖАНА АНЫКТАМАЛАР (ИМПОРТ)
// ==========================================
#include <a_samp>
#include <Pawn.CMD>

#define FACTION_OPG 1
#define DIALOG_OPG_GUNS 100

enum pInfo
{
    pMember,    // Фракция (0 - эч ким эмес, 1 - ОПГ)
    pRank       // Ранг (1-10)
};
new PlayerInfo[MAX_PLAYERS][pInfo];

// ==========================================
// 2. ФУНКЦИЯЛАР ЖАНА ДИАЛОГДОР (CALLBACKS)
// ==========================================
public OnPlayerConnect(playerid)
{
    PlayerInfo[playerid][pMember] = 0;
    PlayerInfo[playerid][pRank] = 0;
    return 1;
}

public OnDialogResponse(playerid, dialogid, response, listitem, inputtext[])
{
    if(dialogid == DIALOG_OPG_GUNS)
    {
        if(response)
        {
            switch(listitem)
            {
                case 0: // Deagle
                {
                    if(PlayerInfo[playerid][pRank] < 2) 
                        return SendClientMessage(playerid, -1, "{FF0000}Ката: {FFFFFF}Deagle алуу үчүн эң аз 2-ранг керек!");
                    
                    GivePlayerWeapon(playerid, 24, 100);
                    SendClientMessage(playerid, 0x00FF00FF, "[ОПГ] Сиз Desert Eagle алдыңыз.");
                }
                case 1: // AK-47
                {
                    if(PlayerInfo[playerid][pRank] < 4) 
                        return SendClientMessage(playerid, -1, "{FF0000}Ката: {FFFFFF}AK-47 алуу үчүн эң аз 4-ранг керек!");
                    
                    GivePlayerWeapon(playerid, 30, 150);
                    SendClientMessage(playerid, 0x00FF00FF, "[ОПГ] Сиз AK-47 алдыңыз.");
                }
                case 2: // Shotgun
                {
                    GivePlayerWeapon(playerid, 25, 50);
                    SendClientMessage(playerid, 0x00FF00FF, "[ОПГ] Сиз Shotgun алдыңыз.");
                }
                case 3: // Броня
                {
                    SetPlayerArmour(playerid, 100.0);
                    SendClientMessage(playerid, 0x00FF00FF, "[ОПГ] Сиз бронежилет кийдиңиз.");
                }
            }
        }
        return 1;
    }
    return 0;
}

// ==========================================
// 3. КОМАНДАЛАР (COMMANDS)
// ==========================================

// ОПГ курал кампасы
CMD:obshak(playerid, params[])
{
    if(PlayerInfo[playerid][pMember] != FACTION_OPG) 
        return SendClientMessage(playerid, -1, "{FF0000}[Ката] {FFFFFF}Сиз ОПГ мүчөсү эмессиз!");

    new string[256];
    format(string, sizeof(string), "1. Desert Eagle (Deagle)\n2. AK-47\n3. Shotgun\n4. Бронежилет");
    ShowPlayerDialog(playerid, DIALOG_OPG_GUNS, DIALOG_STYLE_LIST, "{FF9900}ОПГ Курал Кампасы", string, "Алуу", "Жабуу");
    return 1;
}

// Ранг берүү командасы
CMD:setrank(playerid, params[])
{
    if(PlayerInfo[playerid][pMember] != FACTION_OPG || PlayerInfo[playerid][pRank] < 10)
        return SendClientMessage(playerid, -1, "{FF0000}Ката: {FFFFFF}Бул команда ОПГ лидери үчүн гана!");

    new targetid, rank;
    if(sscanf(params, "ui", targetid, rank)) 
        return SendClientMessage(playerid, -1, "{FF9900}Колдонуу: {FFFFFF}/setrank [Player ID] [Ранг (1-10)]");

    if(!IsPlayerConnected(targetid)) 
        return SendClientMessage(playerid, -1, "{FF0000}Ката: {FFFFFF}Оюнчу табылган жок!");

    if(rank < 1 || rank > 10) 
        return SendClientMessage(playerid, -1, "{FF0000}Ката: {FFFFFF}Ранг 1ден 10го чейин болушу керек!");

    PlayerInfo[targetid][pMember] = FACTION_OPG;
    PlayerInfo[targetid][pRank] = rank;

    new string[128];
    format(string, sizeof(string), "[ОПГ] Сиздин рангыңыз %d деп өзгөртүлдү!", rank);
    SendClientMessage(targetid, 0x00FF00FF, string);
    return 1;
}